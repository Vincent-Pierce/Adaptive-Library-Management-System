@startuml

class Library {
    - books : vector<shared_ptr<Book>>
    - users : vector<User>
    - Library()
    + Instance() : Library&
    + search(strategy : const SearchStrategy&, query : const string&) : bool
    + getBook(query : string) : Book&
    + getBookPointer(book : Book&) : shared_ptr<Book>
    + getUser(query : string) : User&
    + addUser(user : User) : void
    + removeUser(user : User&) : bool
    + clear() : void
    + getBooks() : const vector<shared_ptr<Book>>&
    + getUsers() : const vector<User>&
    + addBook(book : Book) : bool
}

interface Searchable {
    + search(query : string) : bool
}

interface SearchStrategy {
    + search(query : string) : bool
}

class BookSearchStrategy {
    - books : const vector<shared_ptr<Book>>&
    + BookSearchStrategy(books : const vector<shared_ptr<Book>>&)
    + search(query : string) : bool
}

class UserSearchStrategy {
    - users : const vector<User>&
    + UserSearchStrategy(users : const vector<User>&)
    + search(query : string) : bool
}

class Book {
    - available : bool
    - author : string
    - title : string
    + Book(available : bool, author : string, title : string)
    + borrow() : void
    + returnBook() : void
    + search(query : string) : bool
    + isAvailable() : bool
    + getAuthor() : const string
    + getTitle() : const string
}

class User {
    - name : string
    - userId : int
    - borrowedBooks : vector<weak_ptr<Book>>
    + User(name : string, userId : int, borrowedBooks : vector<weak_ptr<Book>>)
    + search(query : string) : bool
    + searchAuthor(query : string) : bool
    + addBook(book : shared_ptr<Book>) : bool
    + trackBorrowedBook(book : shared_ptr<Book>) : void
    + returnBook(book : shared_ptr<Book>) : bool
    + getBookAuthors() : vector<string>
    + getBookCount() : int
    + getUserName() : string
    + getUserId() : int
    + transaction(transaction : Transaction*) : void
}

class Client {
    - lib : Library&
    + Client(lib : Library&)
    + borrowBook(book : Book&, user : User&) : bool
    + returnBook(book : Book&, user : User&) : bool
}

interface Transaction {
    + transaction() : void
}

class BorrowTransaction {
    - lib : Library&
    - book : Book&
    - user : User&
    + BorrowTransaction(lib : Library&, book : Book&, user : User&)
    + transaction() : void
}

class ReturnTransaction {
    - lib : Library&
    - book : Book&
    - user : User&
    + ReturnTransaction(lib : Library&, book : Book&, user : User&)
    + transaction() : void
}

class FileManager {
    + saveLibrary() : void
    + loadLibrary() : void
}

class LibraryException <<exception>> {
    - message : string
    + what() : const char*
}

class BookException <<exception>>
class InputException <<exception>>

Searchable <|.. Book
Searchable <|.. User
SearchStrategy <|.. BookSearchStrategy
SearchStrategy <|.. UserSearchStrategy
Transaction <|.. BorrowTransaction
Transaction <|.. ReturnTransaction

Library "1" o-- "*" Book
Library "1" o-- "*" User
Library ..> SearchStrategy : uses strategy
BookSearchStrategy ..> Book : searches
UserSearchStrategy ..> User : searches
User "1" o-- "*" Book : borrowedBooks (weak references)
User ..> Transaction : invokes
Client --> Library : uses
Client ..> BorrowTransaction : creates
Client ..> ReturnTransaction : creates
BorrowTransaction --> Library : receiver
ReturnTransaction --> Library : receiver
FileManager ..> Library : saves / loads

BookException --|> LibraryException
InputException --|> LibraryException
Library ..> InputException : throws
Book ..> BookException : throws
BorrowTransaction ..> BookException : throws
ReturnTransaction ..> BookException : throws
@enduml
